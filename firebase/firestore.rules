rules_version = '2';
// Czuj: reguły bazy. Zasada: urządzenia tylko DOPISUJĄ anonimowe zgłoszenia (nikt ich nie czyta),
// wszyscy czytają tylko zbiorczą mapę `stats` (liczy ją agregator z kontem serwisowym).
service cloud.firestore {
  match /databases/{database}/documents {

    match /reports/{id} {
      allow read, update, delete: if false;
      allow create: if request.auth != null
        && validReport(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        // jedno zgłoszenie na urządzenie, typ i dzień (id = uid_dzień_typ, tylko tworzenie)
        && id == request.auth.uid + '_' + request.resource.data.day + '_' + request.resource.data.type
        && dayIsNow(request.resource.data.day);
    }

    match /stats/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    function validReport(d) {
      return d.keys().hasOnly(['uid', 'day', 'cell', 'type', 'platform', 'v'])
        && d.keys().hasAll(['uid', 'day', 'cell', 'type', 'platform', 'v'])
        && d.type in ['airtag', 'tile', 'smarttag']
        && d.platform in ['android', 'ios', 'linux']
        && d.v == 1
        && d.day is string && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.cell is string && d.cell.matches('^-?[0-9]{1,2}[.][0-9]{2}:-?[0-9]{1,3}[.][0-9]{2}$');
    }

    // dzień zgłoszenia = dziś (UTC), z zapasem 1 dnia na strefy czasowe i zegar telefonu
    function dayIsNow(day) {
      let p = day.split('-');
      let t = timestamp.date(int(p[0]), int(p[1]), int(p[2]));
      return request.time > t - duration.value(1, 'd') && request.time < t + duration.value(2, 'd');
    }
  }
}
